---
import { profile } from '@data/profile';
import { stack } from '@data/stack';
import { awards, certifications } from '@data/certs';
import { education, languages } from '@data/education';
import { ui } from '@data/i18n';
import type { Locale } from '@data/types';
import { getPage, getProjects, getExperience } from '@lib/content';
import ModeToggle from '@components/shared/ModeToggle.astro';
import LangToggle from '@components/shared/LangToggle.astro';
import ProjectBody from '@components/shared/ProjectBody.astro';
import SkillInventory from '@components/reader/SkillInventory.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const s = t.sections;
const pad = (n: number) => String(n).padStart(2, '0');
const telHref = `tel:+55${profile.phone.replace(/\D/g, '')}`;
const skillCount = stack.reduce((total, group) => total + group.items[locale].length, 0);

const [aboutPage, projects, experience] = await Promise.all([
  getPage('about', locale),
  getProjects(locale),
  getExperience(locale),
]);

const nav = [
  { href: '#sobre', label: s.bio },
  { href: '#projetos', label: s.projects },
  { href: '#stack', label: s.stack },
  { href: '#experiencia', label: s.experience },
  { href: '#certificacoes', label: s.certs },
  { href: '#contato', label: s.contact },
];
---

<div class="reader">
  <a class="skip" href="#conteudo">{t.skipToContent}</a>

  <header class="bar">
    <span class="bar__id">{profile.handle}</span>
    <span class="bar__sep">::</span>
    <span class="led">{locale === 'pt' ? 'online' : 'online'}</span>
    <nav class="bar__nav" aria-label={locale === 'pt' ? 'Seções' : 'Sections'}>
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="bar__controls">
      <ModeToggle locale={locale} />
      <LangToggle locale={locale} />
    </div>
  </header>

  <main id="conteudo">
    <section class="hero">
      <h1 class="hero__name flicker">{profile.name.toUpperCase()}</h1>
      <p class="hero__role">{profile.role[locale]}</p>
      <p class="hero__meta">{profile.location[locale]} &middot; {profile.email} &middot; {profile.phone}</p>
    </section>

    <section class="section" id="sobre">
      <h2 class="section__head">
        <span class="section__prompt">&gt;</span> {s.bio}<span class="crt-cursor"></span>
      </h2>
      <div class="bio">
        <p>{profile.bioShort[locale]}</p>
        {aboutPage && <div class="bio__body" set:html={aboutPage.bodyHtml} />}
      </div>
    </section>

    <section class="section" id="projetos">
      <h2 class="section__head">
        <span class="section__prompt">&gt;</span> {s.projects}
        <span class="section__count">{pad(projects.length)} {locale === 'pt' ? 'arquivos' : 'files'}</span>
      </h2>
      <div class="project-list">
        {projects.map((project) => (
          <article class="win">
            <div class="win__bar">
              <span class="win__title">projeto://{project.slug}</span>
              <span class="win__dots"><i></i><i></i><i></i></span>
            </div>
            <div class="win__body">
              <ProjectBody view={project} locale={locale} />
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section" id="stack">
      <h2 class="section__head">
        <span class="section__prompt">&gt;</span> {s.stack}
        <span class="section__count">{pad(skillCount)} {locale === 'pt' ? 'itens' : 'items'}</span>
      </h2>
      <SkillInventory locale={locale} stack={stack} projects={projects} experience={experience} />
    </section>

    <section class="section" id="experiencia">
      <h2 class="section__head">
        <span class="section__prompt">&gt;</span> {s.experience}
      </h2>
      <ul class="timeline">
        {experience.map((job) => (
          <li>
            <div class="timeline__head">
              <span class="timeline__role">{job.title}</span>
              <span class="timeline__period">{job.period}</span>
            </div>
            <div class="timeline__company">{job.company}</div>
            <div class="timeline__summary" set:html={job.bodyHtml} />
          </li>
        ))}
      </ul>
    </section>

    <section class="section" id="certificacoes">
      <h2 class="section__head">
        <span class="section__prompt">&gt;</span> {s.certs}
      </h2>
      <h3 class="records__head">{locale === 'pt' ? 'formação' : 'education'}</h3>
      <ul class="records">
        {education.map((item) => (
          <li>
            <span class="records__year">{item.period}</span>
            <span>{item.course[locale]} &mdash; <span style="color:var(--amber-dim)">{item.institution[locale]}</span></span>
          </li>
        ))}
      </ul>
      <h3 class="records__head">{locale === 'pt' ? 'certificações' : 'certifications'}</h3>
      <ul class="records">
        {certifications.map((c) => (
          <li>
            <span class="records__year">{c.year}</span>
            <span>{c.name} &mdash; <span style="color:var(--amber-dim)">{c.issuer}</span></span>
          </li>
        ))}
      </ul>
      {awards.map((a) => <div class="award">&#9733; {a.title[locale]} &mdash; {a.issuer} {a.year}</div>)}
      <h3 class="records__head">{locale === 'pt' ? 'idiomas' : 'languages'}</h3>
      <ul class="records">
        {languages.map((item) => (
          <li><span>{item[locale]}</span></li>
        ))}
      </ul>
    </section>

    <section class="section" id="contato">
      <h2 class="section__head">
        <span class="section__prompt">&gt;</span> {s.contact}
      </h2>
      <div class="contact">
        <div class="contact__row">
          <span class="contact__key">email</span>
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
        </div>
        <div class="contact__row">
          <span class="contact__key">{locale === 'pt' ? 'telefone' : 'phone'}</span>
          <a href={telHref}>{profile.phone}</a>
        </div>
        <div class="contact__row">
          <span class="contact__key">{locale === 'pt' ? 'site' : 'website'}</span>
          <a href={profile.website} target="_blank" rel="noopener noreferrer">{profile.website.replace('https://', '').replace(/\/$/, '')}</a>
        </div>
        <div class="contact__row">
          <span class="contact__key">github</span>
          <a href={profile.github} target="_blank" rel="noopener noreferrer">{profile.github.replace('https://', '')}</a>
        </div>
        <div class="contact__row">
          <span class="contact__key">linkedin</span>
          <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">{profile.linkedin.replace('https://www.', '')}</a>
        </div>
        <div class="contact__row">
          <span class="contact__key">{locale === 'pt' ? 'local' : 'location'}</span>
          <span>{profile.location[locale]}</span>
        </div>
      </div>
      <a class="cta" href={profile.cvPath} download>{t.actions.downloadCv} &darr;</a>
    </section>
  </main>

  <footer class="footer">
    <span>&copy; {new Date().getFullYear()} {profile.name}</span>
    <span>nostromo terminal // v1.0</span>
  </footer>
</div>

<script>
  import { mountSkillInventory } from '@scripts/skill-inventory';

  document
    .querySelectorAll<HTMLElement>('[data-shell="reader"] [data-skill-inventory]')
    .forEach((root) => mountSkillInventory(root));
</script>
