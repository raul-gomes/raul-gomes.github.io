---
import { ui } from '@data/i18n';
import type { Locale } from '@data/types';
import type { SectionView } from '@lib/content';

interface Props {
  view: SectionView;
  locale: Locale;
}

const { view, locale } = Astro.props;
const t = ui[locale];
const status = view.status ? t.desktop.statusLabels[view.status] : '';
---

<h2 class="project__title">{view.title}</h2>
{view.tagline && <p class="project__tagline">{view.tagline}</p>}

{view.cover && <img class="project__shot" src={view.cover} alt={`${view.title} — screenshot`} loading="lazy" />}

<div class="project__readme" set:html={view.bodyHtml} />

{view.tags.length > 0 && (
  <ul class="tags" aria-label="stack">
    {view.tags.map((item) => <li>{item}</li>)}
  </ul>
)}

<div class="project__footer">
  {status && <span class="status" data-status={view.status}>{status}</span>}
  {view.links.map((link) => <a href={link.href} target="_blank" rel="noopener noreferrer">[{link.label}]</a>)}
</div>
